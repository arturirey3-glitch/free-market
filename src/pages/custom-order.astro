    };
    const BUDGETS = ["〜5,000円", "〜10,000円", "〜30,000円", "30,000円以上", "未定・相談したい"];

    const state = { item: null, budget: null, galCat: 0, files: [] };
    const $ = id => document.getElementById(id);
    const isTemplate = v => !v.trim() || Object.values(TEMPLATES).includes(v);

    function chips(el, labels, current, onPick) {
      el.innerHTML = "";
      labels.forEach(label => {
        const b = document.createElement("button");
        b.type = "button"; b.className = "co-chip" + (label === current ? " on" : ""); b.textContent = label;
        b.onclick = () => onPick(label);
        el.appendChild(b);
      });
    }
    function renderGallery() {
      chips($("galTabs"), CATS.map(c => c.label), CATS[state.galCat].label, label => {
        state.galCat = CATS.findIndex(c => c.label === label); renderGallery();
      });
      const cat = CATS[state.galCat];
      $("galDesc").textContent = cat.desc;
      $("galGrid").innerHTML = cat.items.map(it =>
        '<a class="co-gal-item" href="/products/' + it.id + '" target="_blank" rel="noopener"><div class="frame"><img src="' + it.img + '" alt="' + it.name.replace(/"/g, "&quot;") + '" loading="lazy"></div><div class="meta"><div class="name">' + it.name + '</div></div></a>'
      ).join("");
      const g = $("galGrid"); g.scrollLeft = 0; updateArrows();
    }
    function updateArrows() {
      const g = $("galGrid"), p = $("galPrev"), n = $("galNext");
      if (!g || !p || !n) return;
      const max = g.scrollWidth - g.clientWidth;
      const noScroll = max <= 6;
      p.disabled = noScroll || g.scrollLeft <= 6;
      n.disabled = noScroll || g.scrollLeft >= max - 6;
    }
    function renderItems() {
      chips($("itemChips"), ITEMS, state.item, label => {
        state.item = label;
        if (isTemplate($("wish").value)) $("wish").value = TEMPLATES[label] || "";
        renderItems();
      });
    }
    function renderBudgets() {
      chips($("budgetChips"), BUDGETS, state.budget, label => { state.budget = (state.budget === label ? null : label); renderBudgets(); });
    }
    function renderThumbs() {
      const t = $("thumbs"); t.innerHTML = "";
      state.files.forEach((f, i) => {
        const d = document.createElement("div"); d.className = "co-thumb";
        const img = document.createElement("div"); img.className = "img"; img.style.backgroundImage = "url(" + f.url + ")";
        const x = document.createElement("button"); x.type = "button"; x.textContent = "✕"; x.setAttribute("aria-label", "削除");
        x.onclick = () => { state.files.splice(i, 1); renderThumbs(); };
        d.appendChild(img); d.appendChild(x); t.appendChild(d);
      });
    }
    function missingFields() {
      const m = [];
      if (!state.item) m.push(["作りたいもの", "itemChips"]);
      if (!$("wish").value.trim()) m.push(["色・サイズなどのご希望", "wish"]);
      if (!(Number($("qty").value) >= 1)) m.push(["希望数量", "qty"]);
      if (!$("name").value.trim()) m.push(["お名前", "name"]);
      if (!/.+@.+\..+/.test($("mail").value)) m.push(["メールアドレス", "mail"]);
      return m;
    }
    function fileToB64(file) {
      return new Promise((resolve) => {
        const r = new FileReader();
        r.onload = () => { const s = String(r.result); const i = s.indexOf(","); resolve({ name: file.name, type: file.type, content: i >= 0 ? s.slice(i + 1) : s }); };
        r.onerror = () => resolve(null);
        r.readAsDataURL(file);
      });
    }

    $("galPrev").onclick = () => $("galGrid").scrollBy({ left: -$("galGrid").clientWidth * 0.8, behavior: "smooth" });
    $("galNext").onclick = () => $("galGrid").scrollBy({ left: $("galGrid").clientWidth * 0.8, behavior: "smooth" });
    $("galGrid").addEventListener("scroll", updateArrows);
    window.addEventListener("resize", updateArrows);

    $("galOrder").onclick = () => {
      state.item = CATS[state.galCat].label;
      if (isTemplate($("wish").value)) $("wish").value = TEMPLATES[state.item] || "";
      renderItems();
      $("wish").scrollIntoView({ behavior: "smooth", block: "center" });
    };
    $("designFiles").onchange = e => {
      Array.from(e.target.files || []).slice(0, 8 - state.files.length).forEach(f => state.files.push({ file: f, name: f.name, url: URL.createObjectURL(f) }));
      e.target.value = ""; renderThumbs();
    };
    ["wish", "qty", "name", "mail"].forEach(id => $(id).addEventListener("input", () => { $("error").style.display = "none"; }));

    $("submit").onclick = async () => {
      const btn = $("submit"); const err = $("error");
      if (btn.classList.contains("loading")) return;
      const miss = missingFields();
      if (miss.length) {
        err.textContent = "未入力の項目があります：" + miss.map(m => m[0]).join("、");
        err.style.display = "block";
        const first = document.getElementById(miss[0][1]);
        first && first.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }
      err.style.display = "none";
      btn.classList.add("loading"); btn.textContent = "送信中…";
      try {
        const images = (await Promise.all(state.files.map(f => fileToB64(f.file)))).filter(Boolean);
        const payload = {
          item: state.item, wish: $("wish").value.trim(), qty: $("qty").value,
          due: $("due").value, budget: state.budget, name: $("name").value.trim(), email: $("mail").value.trim(),
          images,
        };
        const res = await fetch("/api/quote", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || "送信に失敗しました");
        $("success").style.display = "block";
        btn.textContent = "送信済み"; btn.classList.remove("loading");
        $("success").scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (e) {
        err.textContent = "送信に失敗しました。お手数ですがLINEからご連絡ください。（" + (e && e.message || "") + "）";
        err.style.display = "block";
        btn.classList.remove("loading"); btn.disabled = false; btn.textContent = "無料で見積もり依頼";
      }
    };

    renderGallery(); renderItems(); renderBudgets();
    requestAnimationFrame(updateArrows);
  </script>
</BaseLayout>
