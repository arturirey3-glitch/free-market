---
// src/pages/contact.astro
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>お問い合わせ | felikko</title>
  <meta name="description" content="felikkoへのお問い合わせはこちらから。商品に関するご質問・ご注文に関するお問い合わせをお受けしています。">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="stylesheet" href="/_astro/global.Bvx8Z1Av.css">
</head>
<body>
  <div class="min-h-screen flex flex-col">

    <!-- Header -->
    <header class="sticky top-0 z-40 bg-white border-b border-[var(--border-light)]">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between px-4 h-16">
        <a href="/" class="shrink-0">
          <img src="/felikko-logo.png" alt="felikko" class="h-11 w-auto">
        </a>
        <nav class="flex items-center gap-4 text-sm font-medium">
          <a href="/products" class="hidden md:block hover:text-[var(--primary)]">商品一覧</a>
          <a href="/dashboard" class="hidden md:block hover:text-[var(--primary)]">マイページ</a>
          <a href="/auth/login" class="hover:text-[var(--primary)]" data-auth-login>ログイン</a>
          <button type="button" class="hidden hover:text-[var(--primary)]" data-auth-logout>ログアウト</button>
          <a href="/dashboard/products/new" class="btn-primary">出品</a>
        </nav>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1 bg-[var(--bg-secondary)]">
      <div class="mx-auto max-w-[720px] px-4 py-10">

        <!-- タイトル -->
        <div class="mb-8 text-center">
          <h1 class="text-2xl font-bold text-stone-900">お問い合わせ</h1>
          <p class="mt-2 text-sm text-[var(--text-secondary)]">
            商品・ご注文に関するご質問はこちらからお気軽にどうぞ。
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-[1fr_280px]">

          <!-- ── 問い合わせフォーム ── -->
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-5 text-base font-semibold text-stone-900">フォームでお問い合わせ</h2>

            <!-- 送信成功メッセージ -->
            <div id="success-msg" class="hidden mb-4 rounded-xl bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
              ✅ お問い合わせを受け付けました。2〜3営業日以内にご返信します。
            </div>
            <!-- エラーメッセージ -->
            <div id="error-msg" class="hidden mb-4 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-600">
              ❌ 送信に失敗しました。時間をおいて再度お試しください。
            </div>

            <form id="contact-form" class="space-y-4">

              <!-- お名前 -->
              <div>
                <label for="name" class="block text-xs font-semibold text-stone-700 mb-1">
                  お名前 <span class="text-red-500">*</span>
                </label>
                <input
                  type="text" id="name" name="name" required
                  placeholder="山田 太郎"
                  class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-sm outline-none focus:border-[var(--primary)] transition"
                >
              </div>

              <!-- 電話番号 -->
              <div>
                <label for="tel" class="block text-xs font-semibold text-stone-700 mb-1">
                  電話番号
                </label>
                <input
                  type="tel" id="tel" name="tel"
                  placeholder="090-0000-0000"
                  class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-sm outline-none focus:border-[var(--primary)] transition"
                >
              </div>

              <!-- メールアドレス -->
              <div>
                <label for="email" class="block text-xs font-semibold text-stone-700 mb-1">
                  メールアドレス <span class="text-red-500">*</span>
                </label>
                <input
                  type="email" id="email" name="email" required
                  placeholder="example@mail.com"
                  class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-sm outline-none focus:border-[var(--primary)] transition"
                >
              </div>

              <!-- 件名 -->
              <div>
                <label for="subject" class="block text-xs font-semibold text-stone-700 mb-1">
                  件名 <span class="text-red-500">*</span>
                </label>
                <input
                  type="text" id="subject" name="subject" required
                  placeholder="例：商品の在庫について"
                  class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-sm outline-none focus:border-[var(--primary)] transition"
                >
              </div>

              <!-- 注文ID -->
              <div>
                <label for="order_id" class="block text-xs font-semibold text-stone-700 mb-1">
                  注文ID <span class="text-xs text-stone-400 font-normal">（お持ちの場合）</span>
                </label>
                <input
                  type="text" id="order_id" name="order_id"
                  placeholder="例：d2837399"
                  class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-sm outline-none focus:border-[var(--primary)] transition"
                >
              </div>

              <!-- お問い合わせ内容 -->
              <div>
                <label for="message" class="block text-xs font-semibold text-stone-700 mb-1">
                  お問い合わせ内容 <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message" name="message" required rows="5"
                  placeholder="お問い合わせ内容を詳しくご記入ください。"
                  class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-sm outline-none focus:border-[var(--primary)] transition resize-none"
                ></textarea>
              </div>

              <!-- 送信ボタン（短く中央寄せ） -->
              <div class="flex justify-center">
                <button
                  type="submit" id="submit-btn"
                  class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--primary)] text-white h-[48px] px-10 text-sm font-semibold hover:bg-[var(--primary-hover)] transition disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  送信する
                </button>
              </div>

              <p class="text-center text-xs text-stone-400">
                通常2〜3営業日以内にご返信いたします
              </p>

            </form>
          </div>

          <!-- ── サイドバー：LINE ── -->
          <div class="space-y-4">

            <!-- LINEで連絡（クリックでQRモーダル） -->
            <div class="rounded-2xl bg-white p-6 shadow-sm">
              <h2 class="mb-1 text-base font-semibold text-stone-900">LINEで問い合わせ</h2>
              <p class="mb-4 text-xs text-stone-500">
                LINEからでもお気軽にご連絡ください。
              </p>
              <button
                type="button"
                id="line-modal-open"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full h-[48px] px-4 text-sm font-semibold text-white transition hover:opacity-90"
                style="background-color: #06C755;"
              >
                <img src="/icons/LINE_APP_Android.png" alt="LINE" width="22" height="22" class="rounded-[5px]">
                LINEで連絡する
              </button>
              <p class="mt-3 text-xs text-center text-stone-400">
                返信時間：毎日 10:00〜18:00
              </p>
            </div>

            <!-- よくある質問 -->
            <div class="rounded-2xl bg-white p-6 shadow-sm">
              <h2 class="mb-3 text-sm font-semibold text-stone-900">よくあるご質問</h2>
              <ul class="space-y-3 text-xs text-stone-600">
                <li class="flex gap-2">
                  <span class="shrink-0 font-bold text-[var(--primary)]">Q.</span>
                  <span>発送はいつですか？</span>
                </li>
                <li class="pl-4 text-stone-400">ご入金確認後、2〜3日以内に発送します。</li>

                <li class="flex gap-2">
                  <span class="shrink-0 font-bold text-[var(--primary)]">Q.</span>
                  <span>キャンセルはできますか？</span>
                </li>
                <li class="pl-4 text-stone-400">発送前であればキャンセル可能です。フォームよりご連絡ください。</li>

                <li class="flex gap-2">
                  <span class="shrink-0 font-bold text-[var(--primary)]">Q.</span>
                  <span>領収書は発行できますか？</span>
                </li>
                <li class="pl-4 text-stone-400">Stripeの決済明細をご利用ください。</li>
              </ul>
            </div>

          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--border-light)] bg-white py-6 text-center text-xs text-stone-400">
      <p>© 2026 felikko</p>
      <div class="mt-2 flex justify-center gap-4">
        <a href="/privacy" class="hover:underline">プライバシーポリシー</a>
        <a href="/law" class="hover:underline">特定商取引法に基づく表記</a>
        <a href="/contact" class="hover:underline hover:text-[var(--primary)]">お問い合わせ</a>
      </div>
    </footer>

  </div>

  <!-- LINE QR モーダル -->
  <div id="line-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-4">
    <div class="mx-4 max-w-sm w-full transform rounded-2xl bg-white p-6 shadow-xl">
      <div class="text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#06C755]">
          <img src="/icons/LINE_APP_Android.png" alt="LINE" width="28" height="28" class="rounded-[6px]">
        </div>
        <h3 class="text-lg font-semibold text-stone-900">LINEで問い合わせ</h3>
        <p class="mt-2 text-sm text-stone-600">QRコードを読み込むか、ボタンからLINEを開いてください。</p>
        <div class="mt-4 flex justify-center">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https%3A%2F%2Flin.ee%2Ft47Nzid" alt="LINE QRコード" class="h-[200px] w-[200px] rounded-lg border border-stone-200">
        </div>
        <div class="mt-4 space-y-2">
          <a href="https://lin.ee/t47Nzid" target="_blank" rel="noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#06C755] px-6 py-3 text-sm font-semibold text-white hover:bg-[#05b04c]">
            <img src="/icons/LINE_APP_Android.png" alt="LINE" width="16" height="16" class="rounded-[3px]">
            LINEを開く
          </a>
          <button type="button" id="line-copy-btn"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-stone-300 px-6 py-3 text-sm font-medium text-stone-700 hover:bg-stone-50">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span id="line-copy-text">URLをコピー</span>
          </button>
          <button type="button" id="line-modal-close"
            class="w-full rounded-full border border-stone-200 px-6 py-2 text-sm text-stone-500 hover:bg-stone-50">
            閉じる
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ── フォーム送信 ──
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successMsg = document.getElementById('success-msg')!;
    const errorMsg = document.getElementById('error-msg')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中...';
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      const data = {
        name:     (document.getElementById('name') as HTMLInputElement).value,
        tel:      (document.getElementById('tel') as HTMLInputElement).value,
        email:    (document.getElementById('email') as HTMLInputElement).value,
        subject:  (document.getElementById('subject') as HTMLInputElement).value,
        order_id: (document.getElementById('order_id') as HTMLInputElement).value,
        message:  (document.getElementById('message') as HTMLTextAreaElement).value,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          successMsg.classList.remove('hidden');
          form.reset();
        } else {
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          送信する`;
      }
    });

    // ── LINE モーダル ──
    const lineModal = document.getElementById('line-modal')!;
    function openModal() {
      lineModal.classList.remove('hidden');
      lineModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      lineModal.classList.add('hidden');
      lineModal.classList.remove('flex');
      document.body.style.overflow = '';
    }
    document.getElementById('line-modal-open')?.addEventListener('click', openModal);
    document.getElementById('line-modal-close')?.addEventListener('click', closeModal);
    lineModal.addEventListener('click', (e) => { if (e.target === lineModal) closeModal(); });
    document.getElementById('line-copy-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText('https://lin.ee/t47Nzid');
      const txt = document.getElementById('line-copy-text');
      if (txt) { txt.textContent = 'コピーしました！'; setTimeout(() => { txt.textContent = 'URLをコピー'; }, 2000); }
    });
  </script>
</body>
</html>
