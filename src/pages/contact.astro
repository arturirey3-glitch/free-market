---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---
<BaseLayout title="お問い合わせ | felikko" description="felikkoへのお問い合わせ。商品・ご注文に関するご質問はこちら。">

  <div class="bg-[var(--bg-secondary)] min-h-screen">
    <div class="mx-auto max-w-[640px] px-4 py-10">

      <!-- タイトル -->
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-stone-900">お問い合わせ</h1>
        <p class="mt-2 text-sm text-stone-500">
          ご質問・ご要望はいつでもお気軽にどうぞ。<br>
          通常2〜3営業日以内にご返信いたします。
        </p>
      </div>

      <!-- 連絡方法の選択（2択） -->
      <div class="grid grid-cols-2 gap-3 mb-8">
        <!-- フォーム -->
        <button type="button" id="tab-form"
          class="flex flex-col items-center gap-2 rounded-2xl border-2 p-5 transition"
          style="border-color: var(--primary); background: var(--primary-light, #f0fdf4);"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-sm">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: var(--primary)">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </span>
          <span class="text-sm font-semibold" style="color: var(--primary)">メールフォーム</span>
          <span class="text-[10px] text-stone-500">2〜3営業日以内</span>
        </button>

        <!-- LINE -->
        <button type="button" id="tab-line"
          class="flex flex-col items-center gap-2 rounded-2xl border-2 border-stone-200 bg-white p-5 transition hover:border-[#06C755]"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-full" style="background:#06C755;">
            <img src="/icons/LINE_APP_Android.png" alt="LINE" width="24" height="24" class="rounded-[5px]">
          </span>
          <span class="text-sm font-semibold text-stone-800">LINE</span>
          <span class="text-[10px] text-stone-500">即日〜翌日対応</span>
        </button>
      </div>

      <!-- ── フォームパネル ── -->
      <div id="panel-form" class="rounded-2xl bg-white p-6 shadow-sm">

        <!-- 送信成功 -->
        <div id="success-msg" class="hidden mb-5 rounded-xl bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
          ✅ お問い合わせを受け付けました。2〜3営業日以内にご返信します。
        </div>
        <!-- エラー -->
        <div id="error-msg" class="hidden mb-5 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-600">
          ❌ 送信に失敗しました。時間をおいて再度お試しください。
        </div>

        <form id="contact-form" class="space-y-4">

          <!-- 名前・電話（sm以上で横並び） -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="name" class="block text-xs font-semibold text-stone-600 mb-1">
                お名前 <span class="text-red-500">*</span>
              </label>
              <input type="text" id="name" name="name" required
                placeholder="山田 太郎"
                class="w-full rounded-xl border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] transition"
              >
            </div>
            <div>
              <label for="tel" class="block text-xs font-semibold text-stone-600 mb-1">電話番号</label>
              <input type="tel" id="tel" name="tel"
                placeholder="090-0000-0000"
                class="w-full rounded-xl border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] transition"
              >
            </div>
          </div>

          <!-- メール -->
          <div>
            <label for="email" class="block text-xs font-semibold text-stone-600 mb-1">
              メールアドレス <span class="text-red-500">*</span>
            </label>
            <input type="email" id="email" name="email" required
              placeholder="example@mail.com"
              class="w-full rounded-xl border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] transition"
            >
          </div>

          <!-- 件名 -->
          <div>
            <label for="subject" class="block text-xs font-semibold text-stone-600 mb-1">
              件名 <span class="text-red-500">*</span>
            </label>
            <select id="subject" name="subject" required
              class="w-full rounded-xl border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] transition bg-white"
            >
              <option value="">選択してください</option>
              <option value="商品について">商品について</option>
              <option value="注文・支払いについて">注文・支払いについて</option>
              <option value="配送・発送について">配送・発送について</option>
              <option value="返品・キャンセルについて">返品・キャンセルについて</option>
              <option value="その他">その他</option>
            </select>
          </div>

          <!-- 注文ID -->
          <div>
            <label for="order_id" class="block text-xs font-semibold text-stone-600 mb-1">
              注文ID <span class="text-[10px] text-stone-400 font-normal ml-1">（お持ちの場合）</span>
            </label>
            <input type="text" id="order_id" name="order_id"
              placeholder="例：d2837399"
              class="w-full rounded-xl border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] transition"
            >
          </div>

          <!-- お問い合わせ内容 -->
          <div>
            <label for="message" class="block text-xs font-semibold text-stone-600 mb-1">
              お問い合わせ内容 <span class="text-red-500">*</span>
            </label>
            <textarea id="message" name="message" required rows="5"
              placeholder="お問い合わせ内容をできるだけ詳しくご記入ください。"
              class="w-full rounded-xl border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] transition resize-none"
            ></textarea>
          </div>

          <div class="flex justify-center pt-1">
            <button type="submit" id="submit-btn"
              class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] text-white h-[48px] px-10 text-sm font-semibold hover:bg-[var(--primary-hover)] transition disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              送信する
            </button>
          </div>

        </form>
      </div>

      <!-- ── LINE パネル（非表示） ── -->
      <div id="panel-line" class="hidden rounded-2xl bg-white p-8 shadow-sm text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full" style="background:#06C755;">
          <img src="/icons/LINE_APP_Android.png" alt="LINE" width="32" height="32" class="rounded-[7px]">
        </div>
        <h2 class="text-lg font-bold text-stone-900">LINEで問い合わせ</h2>
        <p class="mt-2 mb-5 text-sm text-stone-500">
          QRコードを読み込むか、ボタンからLINEを開いてください。<br>
          <span class="text-xs">対応時間：毎日 10:00〜17:00</span>
        </p>
        <div class="flex justify-center mb-5">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https%3A%2F%2Flin.ee%2Ft47Nzid"
            alt="LINE QRコード" class="h-[180px] w-[180px] rounded-xl border border-stone-200">
        </div>
        <div class="space-y-2 max-w-[260px] mx-auto">
          <a href="https://lin.ee/t47Nzid" target="_blank" rel="noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full h-[48px] px-6 text-sm font-semibold text-white hover:opacity-90 transition"
            style="background:#06C755;">
            <img src="/icons/LINE_APP_Android.png" alt="" width="18" height="18" class="rounded-[4px]">
            LINEを開く
          </a>
          <button type="button" id="line-copy-btn"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-stone-200 h-[44px] px-6 text-sm text-stone-600 hover:bg-stone-50 transition">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span id="line-copy-text">URLをコピー</span>
          </button>
        </div>
      </div>

      <!-- よくある質問 -->
      <div class="mt-6 rounded-2xl bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-sm font-semibold text-stone-900">よくあるご質問</h2>
        <div class="space-y-4 text-sm">
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-stone-800 list-none">
              発送はいつですか？
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="mt-2 text-stone-500 text-xs leading-relaxed pl-1">ご入金確認後、2〜3日以内に発送します。</p>
          </details>
          <hr class="border-stone-100">
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-stone-800 list-none">
              キャンセルはできますか？
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="mt-2 text-stone-500 text-xs leading-relaxed pl-1">発送前であればキャンセル可能です。お早めにフォームよりご連絡ください。</p>
          </details>
          <hr class="border-stone-100">
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-stone-800 list-none">
              領収書は発行できますか？
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="mt-2 text-stone-500 text-xs leading-relaxed pl-1">Stripeの決済明細をご利用ください。マイページからダウンロードいただけます。</p>
          </details>
        </div>
      </div>

    </div>
  </div>

  <script>
    // ── タブ切り替え ──
    const tabForm = document.getElementById('tab-form')!;
    const tabLine = document.getElementById('tab-line')!;
    const panelForm = document.getElementById('panel-form')!;
    const panelLine = document.getElementById('panel-line')!;

    function showForm() {
      panelForm.classList.remove('hidden');
      panelLine.classList.add('hidden');
      tabForm.style.cssText = 'border-color: var(--primary); background: var(--primary-light, #f0fdf4);';
      (tabForm.querySelector('span.text-sm') as HTMLElement).style.color = 'var(--primary)';
      tabLine.style.cssText = 'border-color: #e7e5e4; background: #fff;';
      (tabLine.querySelector('span.text-sm') as HTMLElement).style.color = '#1c1917';
    }

    function showLine() {
      panelForm.classList.add('hidden');
      panelLine.classList.remove('hidden');
      tabLine.style.cssText = 'border-color: #06C755; background: #f0fdf4;';
      (tabLine.querySelector('span.text-sm') as HTMLElement).style.color = '#06C755';
      tabForm.style.cssText = 'border-color: #e7e5e4; background: #fff;';
      (tabForm.querySelector('span.text-sm') as HTMLElement).style.color = '#1c1917';
    }

    tabForm.addEventListener('click', showForm);
    tabLine.addEventListener('click', showLine);

    // ── フォーム送信 ──
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successMsg = document.getElementById('success-msg')!;
    const errorMsg = document.getElementById('error-msg')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中...';
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      const data = {
        name:     (document.getElementById('name') as HTMLInputElement).value,
        tel:      (document.getElementById('tel') as HTMLInputElement).value,
        email:    (document.getElementById('email') as HTMLInputElement).value,
        subject:  (document.getElementById('subject') as HTMLSelectElement).value,
        order_id: (document.getElementById('order_id') as HTMLInputElement).value,
        message:  (document.getElementById('message') as HTMLTextAreaElement).value,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          successMsg.classList.remove('hidden');
          form.reset();
        } else {
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          送信する`;
      }
    });

    // ── LINE URLコピー ──
    document.getElementById('line-copy-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText('https://lin.ee/t47Nzid');
      const txt = document.getElementById('line-copy-text');
      if (txt) { txt.textContent = 'コピーしました！'; setTimeout(() => { txt.textContent = 'URLをコピー'; }, 2000); }
    });
  </script>

</BaseLayout>
