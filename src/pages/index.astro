---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { createSupabaseServer } from '../lib/supabaseServer';
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const INITIAL_LIMIT = 48;

let products: any[] = [];
let pickupProducts: any[] = [];
let errorMessage = '';
let hasMore = false;

const buildRatingMap = (rows: { product_id: string; rating: number | null }[]) => {
  const map = new Map<string, { count: number; sum: number }>();
  rows.forEach((row) => {
    if (!row.product_id || row.rating == null) return;
    const c = map.get(row.product_id) ?? { count: 0, sum: 0 };
    c.count += 1;
    c.sum += row.rating;
    map.set(row.product_id, c);
  });
  return map;
};

try {
  const supabase = createSupabaseServer();

  // 全商品数を取得
  const { count: totalCount } = await supabase
    .from('products')
    .select('id', { count: 'exact', head: true })
    .eq('status', 'published')
    .eq('is_pickup', false);

  // ピックアップ取得
  const { data: pickupData } = await supabase
    .from('products')
    .select('id,title,price,thumbnail_url,is_pickup')
    .eq('status', 'published')
    .eq('is_pickup', true)
    .order('sort_order', { ascending: true, nullsFirst: false });

  // 通常商品（初期分）
  const { data, error } = await supabase
    .from('products')
    .select('id,title,price,thumbnail_url,is_pickup')
    .eq('status', 'published')
    .eq('is_pickup', false)
    .order('sort_order', { ascending: true, nullsFirst: false })
    .order('created_at', { ascending: false })
    .range(0, INITIAL_LIMIT - 1);

  if (error) throw error;
  const all = [...(pickupData ?? []), ...(data ?? [])];

  const ids = all.map((p) => p.id).filter(Boolean);
  let ratingMap = new Map<string, { count: number; sum: number }>();
  if (ids.length > 0) {
    const { data: revRows } = await supabase.from('reviews').select('product_id,rating').in('product_id', ids);
    if (revRows) ratingMap = buildRatingMap(revRows);
  }

  const withRatings = all.map((p) => {
    const s = ratingMap.get(p.id);
    return { ...p, review_count: s?.count ?? 0, review_average: s && s.count > 0 ? s.sum / s.count : 0 };
  });

  pickupProducts = withRatings.filter((p) => p.is_pickup);
  products = withRatings.filter((p) => !p.is_pickup);
  hasMore = (data?.length ?? 0) >= INITIAL_LIMIT && INITIAL_LIMIT < (totalCount ?? 0);
} catch {
  errorMessage = 'データの取得に失敗しました。';
}
---
<BaseLayout
  title="felikko | スタバ・マリメッコ雑貨のフリマ通販"
  description="felikkoはスタバグッズ・マリメッコ・北欧インテリア雑貨を中心としたフリマ通販サイトです。クッションカバー・マット・スマホリングなど人気商品を多数取り揃え。即購入OK・送料込みで安心お買い物。"
  jsonLd={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "felikko",
    "url": "https://www.felikko.com",
    "description": "スタバ・マリメッコ・北欧インテリア雑貨のフリマ通販サイト",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://www.felikko.com/products?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    }
  })}
>
  <div class="mx-auto max-w-[1440px] px-4 py-6">
    <h1 class="sr-only">felikko | スタバ・マリメッコ雑貨のフリマ通販</h1>
    {errorMessage && (
      <div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-700">
        {errorMessage}
      </div>
    )}

    {pickupProducts.length > 0 && (
      <section class="mb-8">
        <h2 class="text-base font-bold mb-4 flex items-center gap-1.5">
          <span>⭐</span> ピックアップ商品
        </h2>
        <div class="grid-products">
          {pickupProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </section>
    )}

    <h2 class="text-base font-bold mb-4">新着商品</h2>
    {products.length > 0 ? (
      <>
        <div class="grid-products" id="products-grid">
          {products.map((product) => <ProductCard product={product} />)}
        </div>

        {hasMore && (
          <div class="mt-8 flex justify-center" id="load-more-wrapper">
            <button
              id="load-more-btn"
              data-offset={String(products.length)}
              class="rounded-full bg-[var(--primary)] px-10 py-3 text-sm font-bold text-white shadow hover:opacity-90 active:scale-95 transition disabled:opacity-50"
            >
              もっと見る
            </button>
          </div>
        )}
      </>
    ) : (
      <p class="text-sm text-[var(--text-secondary)] py-12 text-center">
        まだ商品がありません。<a href="/dashboard/products/new" class="text-[var(--primary)] font-bold">出品する</a>
      </p>
    )}
  </div>
</BaseLayout>

<script>
const btn = document.getElementById('load-more-btn') as HTMLButtonElement | null;
const grid = document.getElementById('products-grid');
const wrapper = document.getElementById('load-more-wrapper');

const LIMIT = 48;

function formatJPY(price: number) {
  return '￥' + price.toLocaleString('ja-JP');
}

function renderCard(p: any): string {
  const shortId = p.id.slice(0, 8);
  const img = p.thumbnail_url
    ? `<img src="${p.thumbnail_url}" alt="${p.title.replace(/"/g, '&quot;')}" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />`
    : `<div class="flex h-full w-full items-center justify-center text-sm text-[var(--text-placeholder)]">No Image</div>`;
  const stars = (p.review_count ?? 0) > 0
    ? `<div class="mt-1 flex items-center gap-0.5 text-[10px] text-[var(--text-secondary)]"><span class="text-[var(--star)]">★</span><span>${Number(p.review_average).toFixed(1)}</span><span>(${p.review_count})</span></div>`
    : '';
  return `
    <a href="/products/${shortId}" class="card block group">
      <div class="relative aspect-square w-full bg-[var(--bg-secondary)]">
        <div class="absolute inset-0 overflow-hidden">${img}</div>
        <div class="absolute bottom-3 left-0 rounded-r-full bg-black/50 text-white text-base font-bold px-4 py-1.5 leading-tight">${formatJPY(p.price)}</div>
      </div>
      <div class="px-2 py-2">
        <h3 class="text-xs leading-snug line-clamp-2">${p.title}</h3>
        ${stars}
      </div>
    </a>`;
}

btn?.addEventListener('click', async () => {
  if (!btn || !grid) return;
  const offset = parseInt(btn.dataset.offset ?? '0', 10);

  btn.disabled = true;
  btn.textContent = '読み込み中...';

  try {
    const res = await fetch(`/api/products?offset=${offset}&limit=${LIMIT}`);
    const json = await res.json();

    json.products.forEach((p: any) => {
      grid.insertAdjacentHTML('beforeend', renderCard(p));
    });

    btn.dataset.offset = String(offset + json.products.length);

    if (!json.hasMore) {
      wrapper?.remove();
    } else {
      btn.disabled = false;
      btn.textContent = 'もっと見る';
    }
  } catch {
    btn.disabled = false;
    btn.textContent = 'もっと見る';
  }
});
</script>
