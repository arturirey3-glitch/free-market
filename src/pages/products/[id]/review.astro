---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseServer } from '../../../lib/supabaseServer';

export const prerender = false;

const { id } = Astro.params;
const url = new URL(Astro.request.url);
const token = url.searchParams.get('token') ?? '';

let product: any = null;
let tokenValid = false;
let tokenUsed = false;
let tokenExpired = false;

try {
  const supabase = createSupabaseServer();

  if (token) {
    const { data: tokenData } = await supabase
      .from('review_tokens').select('*').eq('token', token).single();

    if (tokenData) {
      if (tokenData.used) { tokenUsed = true; }
      else if (new Date(tokenData.expires_at) < new Date()) { tokenExpired = true; }
      else { tokenValid = true; }

      const isShort = id && id.length === 8;
      if (isShort) {
        const { data } = await supabase
          .from('products').select('id,title,thumbnail_url').eq('status', 'published');
        product = data?.find((p: any) => p.id.startsWith(id!)) ?? null;
      } else {
        const { data } = await supabase
          .from('products').select('id,title,thumbnail_url')
          .eq('id', id).eq('status', 'published').single();
        product = data;
      }
    }
  }
} catch {}

const STAR_SVG = `<svg viewBox="0 0 24 24" class="star-icon w-full h-full"><path d="M22,9.69a.72.72,0,0,0-.57-.48l-6.06-.88L12.63,2.86a.73.73,0,0,0-1.26,0L8.66,8.33,2.6,9.21A.72.72,0,0,0,2,9.69a.69.69,0,0,0,.18.71L6.6,14.66l-1,6a.71.71,0,0,0,.28.69.73.73,0,0,0,.74.05L12,18.58l5.42,2.84a.72.72,0,0,0,.74-.05.71.71,0,0,0,.28-.69l-1-6,4.39-4.26A.69.69,0,0,0,22,9.69Z"/></svg>`;
const RATING_LABELS: Record<number, string> = { 1: '悪い', 2: 'やや悪い', 3: '普通', 4: '良い', 5: 'とても良い' };
---
<BaseLayout title="レビュー投稿 | felikko">
  <main class="mx-auto max-w-xl px-4 py-8">

    {!token ? (
      <p class="py-20 text-center text-sm text-stone-500">レビュートークンが必要です。</p>
    ) : tokenUsed ? (
      <p class="py-20 text-center text-sm text-red-500">このトークンは使用済みです。</p>
    ) : tokenExpired ? (
      <p class="py-20 text-center text-sm text-red-500">トークンの有効期限が切れています。</p>
    ) : !tokenValid ? (
      <p class="py-20 text-center text-sm text-red-500">トークンが無効です。</p>
    ) : !product ? (
      <p class="py-20 text-center text-sm text-stone-500">商品が見つかりません。</p>
    ) : (
      <>
        {/* 商品ヘッダー */}
        <div class="mb-6 flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-4">
          {product.thumbnail_url ? (
            <img src={product.thumbnail_url} alt={product.title}
              class="h-16 w-16 rounded-xl object-cover flex-shrink-0" />
          ) : (
            <div class="h-16 w-16 rounded-xl bg-stone-100 flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">📦</span>
            </div>
          )}
          <div>
            <h1 class="font-semibold text-stone-900">{product.title}</h1>
            <p class="mt-1 text-sm text-stone-500">この商品のレビューを投稿してください</p>
          </div>
        </div>

        {/* フォームカード */}
        <div class="rounded-3xl border border-stone-200 bg-white/80 p-6 shadow-sm">
          <h2 class="text-lg font-semibold">レビュー投稿</h2>
          <form class="mt-6 space-y-5" id="review-form"
            data-product-id={product.id} data-token={token}>

            {/* 星評価 */}
            <div>
              <label class="text-sm font-medium text-stone-700">
                評価 <span class="text-red-500">*</span>
              </label>
              <div class="mt-3 flex gap-2" id="rating-stars">
                {[1,2,3,4,5].map(n => (
                  <button type="button"
                    class="rating-star h-10 w-10 rounded-full border-2 p-1.5 transition-all hover:border-amber-300 hover:bg-amber-50 border-stone-200 bg-white"
                    data-star={n}>
                    <Fragment set:html={STAR_SVG} />
                  </button>
                ))}
              </div>
              <input type="hidden" name="rating" id="rating-input" required />
              <p class="mt-2 text-sm text-stone-500" id="rating-text">星をタップして評価してください</p>
            </div>

            {/* 評価コメント */}
            <div>
              <label class="text-sm font-medium text-stone-700">
                評価コメント <span class="text-red-500">*</span>
              </label>
              <textarea name="body" rows="4" required maxlength="500"
                placeholder="商品の感想をお聞かせください"
                class="mt-2 w-full rounded-2xl border border-stone-200 bg-white px-4 py-3 text-sm focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-100"
                id="body-textarea"></textarea>
              <p class="mt-1 text-right text-xs text-stone-400">
                <span id="char-count">0</span>/500
              </p>
            </div>

            {/* ニックネーム */}
            <div>
              <label class="text-sm font-medium text-stone-700">
                ニックネーム <span class="text-red-500">*</span>
              </label>
              <input type="text" name="reviewer_name" required maxlength="30"
                placeholder="例: たろう"
                class="mt-2 w-full rounded-2xl border border-stone-200 bg-white px-4 py-3 text-sm focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-100" />
            </div>

            {/* アバター画像 */}
            <div>
              <label class="text-sm font-medium text-stone-700">
                アバター画像（任意）
              </label>
              <div class="mt-2 flex items-center gap-4">
                <div class="h-14 w-14 flex-shrink-0 overflow-hidden rounded-full bg-stone-100" id="avatar-preview">
                  <div class="flex h-full w-full items-center justify-center text-lg text-stone-400" id="avatar-placeholder">?</div>
                  <img id="avatar-img" class="hidden h-full w-full object-cover" src="" alt="" />
                </div>
                <label class="cursor-pointer rounded-full border border-stone-200 px-4 py-2 text-sm hover:bg-stone-50">
                  画像を選択
                  <input type="file" name="reviewer_avatar" accept="image/*" class="hidden" id="avatar-input" />
                </label>
              </div>
              <input type="hidden" name="reviewer_avatar_url" id="avatar-url-input" />
            </div>

            {/* 確認チェック */}
            <div class="flex items-start gap-3 rounded-xl border border-stone-100 bg-stone-50 p-4">
              <input type="checkbox" id="confirm_check" name="confirm_check" required
                class="mt-0.5 h-5 w-5 rounded border-stone-300 accent-amber-500" />
              <label for="confirm_check" class="text-sm text-stone-600">
                投稿内容を確認しました。このレビューは公開されます。
              </label>
            </div>

            {/* 送信ボタン */}
            <button type="submit" id="submit-btn"
              style="display:block;width:100%;padding:0.875rem 1.5rem;background-color:#d97706;color:white;font-weight:600;font-size:0.875rem;border-radius:9999px;border:none;cursor:pointer;transition:opacity .2s;">
              レビューを投稿する
            </button>
            <p class="text-center text-xs text-stone-500" id="form-message"></p>
          </form>
        </div>

        <div class="mt-6 text-center">
          <a href={`/products/${product.id.slice(0,8)}`}
            class="text-sm text-stone-500 hover:underline">← 商品詳細に戻る</a>
        </div>
      </>
    )}
  </main>

  <script>
  import { supabase } from '../../../lib/supabaseClient';

  const form = document.getElementById('review-form') as HTMLFormElement | null;
  if (!form) { /* not shown (invalid token etc.) */ }
  else {
    const productId = form.dataset.productId!;
    const token = form.dataset.token!;
    const ratingInput = document.getElementById('rating-input') as HTMLInputElement;
    const ratingText = document.getElementById('rating-text')!;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const formMessage = document.getElementById('form-message')!;
    const bodyTextarea = document.getElementById('body-textarea') as HTMLTextAreaElement;
    const charCount = document.getElementById('char-count')!;
    const avatarInput = document.getElementById('avatar-input') as HTMLInputElement;
    const avatarImg = document.getElementById('avatar-img') as HTMLImageElement;
    const avatarPlaceholder = document.getElementById('avatar-placeholder')!;
    const avatarUrlInput = document.getElementById('avatar-url-input') as HTMLInputElement;

    const LABELS: Record<string, string> = { '1':'悪い','2':'やや悪い','3':'普通','4':'良い','5':'とても良い' };

    // 星評価
    document.querySelectorAll<HTMLButtonElement>('.rating-star').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.star!;
        ratingInput.value = val;
        ratingText.textContent = LABELS[val] ?? '';
        document.querySelectorAll<HTMLButtonElement>('.rating-star').forEach(b => {
          const n = Number(b.dataset.star!);
          const active = n <= Number(val);
          b.classList.toggle('border-amber-400', active);
          b.classList.toggle('bg-amber-50', active);
          b.classList.toggle('border-stone-200', !active);
          b.classList.toggle('bg-white', !active);
          const svg = b.querySelector('svg')!;
          svg.setAttribute('fill', active ? '#f59e0b' : '#d6d3d1');
        });
      });
    });

    // 文字カウンター
    bodyTextarea.addEventListener('input', () => {
      charCount.textContent = String(bodyTextarea.value.length);
    });

    // アバタープレビュー
    avatarInput.addEventListener('change', () => {
      const file = avatarInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        avatarImg.src = String(e.target?.result ?? '');
        avatarImg.classList.remove('hidden');
        avatarPlaceholder.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    });

    // 送信
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!ratingInput.value) {
        formMessage.textContent = '評価を選択してください';
        formMessage.style.color = '#ef4444';
        return;
      }
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';
      submitBtn.textContent = '投稿中...';
      formMessage.textContent = '';

      try {
        // アバター画像アップロード
        let avatarUrl: string | null = null;
        const avatarFile = avatarInput.files?.[0];
        if (avatarFile) {
          const ext = avatarFile.name.split('.').pop() || 'jpg';
          const path = `reviews/${productId}/${token}.${ext}`;
          const { error: uploadErr } = await supabase.storage
            .from('product-images').upload(path, avatarFile, { upsert: true });
          if (!uploadErr) {
            const { data: urlData } = supabase.storage.from('product-images').getPublicUrl(path);
            avatarUrl = urlData.publicUrl;
          }
        }

        const fd = new FormData(form);
        const { error } = await supabase.from('reviews').insert({
          product_id: productId,
          rating: Number(ratingInput.value),
          reviewer_name: String(fd.get('reviewer_name') ?? ''),
          body: String(fd.get('body') ?? ''),
          reviewer_avatar_url: avatarUrl,
        });

        if (error) throw new Error(error.message);

        await supabase.from('review_tokens').update({ used: true }).eq('token', token);

        formMessage.textContent = 'レビューを投稿しました。ありがとうございます！';
        formMessage.style.color = '#16a34a';
        submitBtn.textContent = '投稿完了 ✓';
        form.querySelectorAll('input,textarea,button,select').forEach((el: any) => { el.disabled = true; });
        setTimeout(() => {
          window.location.href = `/products/${productId.slice(0, 8)}`;
        }, 2000);
      } catch (err: any) {
        formMessage.textContent = err.message ?? '投稿に失敗しました';
        formMessage.style.color = '#ef4444';
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.textContent = 'レビューを投稿する';
      }
    });
  }
  </script>
</BaseLayout>
