const AVATAR_COLORS_C = ['#ef4444','#f97316','#eab308','#22c55e','#14b8a6','#3b82f6','#8b5cf6','#ec4899','#6366f1','#10b981'];
function getColorC(name: string) {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
  return AVATAR_COLORS_C[Math.abs(h) % AVATAR_COLORS_C.length];
}
function fmtDate(iso: string) {
  // 日付＋時間（例: 2026/05/17 14:32）
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso.slice(0,10).replace(/-/g,'/');
  const date = `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}`;
  const time = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  return `${date} ${time}`;
}

function buildCommentEl(c: any): HTMLElement {
  const div = document.createElement('div');
  div.dataset.commentId = c.id;
  div.id = `comment-${c.id}`;
  const adminBadge = c.is_admin ? '<span class="rounded-full bg-[var(--primary)] px-2 py-0.5 text-[9px] text-white font-bold">出品者</span>' : '';
  const dateStr = fmtDate(c.created_at ?? '');
  div.className = 'rounded-xl border border-[var(--border-light)] p-4 bg-white';

  // アバター生成（owner-avatar-urlはサーバー側から直接取得 → タイミング問題なし）
  const ownerAvatarUrl = (document.getElementById('owner-avatar-url') as HTMLInputElement)?.value || '';
  const avatarHtml = (() => {
    if (c.is_admin) {
      if (ownerAvatarUrl) {
        return `<div class="h-9 w-9 shrink-0 overflow-hidden rounded-full border-2 border-[var(--primary)]"><img src="${ownerAvatarUrl}" alt="出品者" class="h-full w-full object-cover"/></div>`;
      }
      return `<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--primary)] text-white text-xs font-bold">出</div>`;
    }
    const displayName = c.name && c.name !== '匿名' ? c.name : '';
    if (displayName) {
      const color = getColorC(displayName);
      return `<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white text-sm font-bold" style="background:${color}">${Array.from(displayName)[0].toUpperCase()}</div>`;
    }
    return `<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-400"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg></div>`;
  })();

  div.innerHTML = `
    <div class="flex items-start gap-3">
      ${avatarHtml}
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 flex-wrap">
            ${c.is_admin ? adminBadge : `<span class="text-xs font-medium text-stone-600">${(c.name && c.name !== '匿名' ? c.name : '匿名ユーザー').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</span>`}
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-[10px] text-stone-400">${dateStr}</span>
            ${!c.is_admin ? '<button type="button" data-comment-reply class="hidden text-[10px] text-[var(--primary)] hover:underline transition">返信</button>' : ''}
            <button type="button" data-comment-delete class="hidden text-[10px] text-red-400 hover:text-red-600 transition">削除</button>
          </div>
        </div>
        <p class="mt-1.5 text-sm text-stone-700 whitespace-pre-wrap leading-relaxed">${c.message.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</p>
      </div>
    </div>`;
  return div;
}

let _adminToken: string | null = null;

function showAdminReplyForm(commentEl: HTMLElement, token: string) {
  const existing = commentEl.querySelector('[data-admin-reply-form]');
  if (existing) { existing.remove(); return; }
  const form = document.createElement('div');
  form.dataset.adminReplyForm = '';
  form.className = 'mt-3 pt-3 border-t border-stone-100';
  form.innerHTML = `
    <textarea placeholder="返信を入力..." rows="2"
      class="w-full rounded-lg border border-[var(--border)] px-3 py-2.5 text-sm outline-none focus:border-[var(--primary)] resize-none bg-white"></textarea>
    <div class="mt-2 flex gap-2">
      <button type="button" data-reply-submit class="rounded-full bg-[var(--primary)] px-5 py-1.5 text-xs font-semibold text-white">返信する</button>
      <button type="button" data-reply-cancel class="rounded-full border border-stone-200 px-5 py-1.5 text-xs text-stone-500">キャンセル</button>
    </div>`;
  commentEl.appendChild(form);
  (form.querySelector('textarea') as HTMLTextAreaElement)?.focus();

  form.querySelector('[data-reply-submit]')?.addEventListener('click', async () => {
    const textarea = form.querySelector('textarea') as HTMLTextAreaElement;
    const message = textarea.value.trim();
    if (!message) return;
    const submitBtn = form.querySelector('[data-reply-submit]') as HTMLButtonElement;
    submitBtn.disabled = true; submitBtn.textContent = '送信中...';
    const parentId = commentEl.dataset.commentId;
    const res = await fetch('/api/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ product_id: productId, product_title: productTitle, product_url: productUrl, message, access_token: token, in_reply_to: parentId }),
    });
    if (res.ok) { form.remove(); await loadComments(); }
    else { submitBtn.disabled = false; submitBtn.textContent = '返信する'; }
  });
  form.querySelector('[data-reply-cancel]')?.addEventListener('click', () => form.remove());
}

function showCommentDeleteButtons(token: string) {
  _adminToken = token;
  document.querySelectorAll<HTMLElement>('#comment-list [data-comment-id]').forEach(el => {
    // 返信ボタン
    const replyBtn = el.querySelector<HTMLButtonElement>('[data-comment-reply]');
    if (replyBtn) {
      replyBtn.classList.remove('hidden');
      const newReply = replyBtn.cloneNode(true) as HTMLButtonElement;
      newReply.classList.remove('hidden');
      replyBtn.replaceWith(newReply);
      newReply.addEventListener('click', () => showAdminReplyForm(el, token));
    }
    // 削除ボタン
    const btn = el.querySelector<HTMLButtonElement>('[data-comment-delete]');
    if (!btn) return;
    btn.classList.remove('hidden');
    const newBtn = btn.cloneNode(true) as HTMLButtonElement;
    newBtn.classList.remove('hidden');
    btn.replaceWith(newBtn);
    newBtn.addEventListener('click', async () => {
      if (!confirm('このコメントを削除しますか？')) return;
      const res = await fetch('/api/comments', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ comment_id: el.dataset.commentId, access_token: token }),
      });
      if (res.ok) {
        el.remove();
        const countEl = document.getElementById('comment-count');
        const remaining = document.querySelectorAll('#comment-list [data-comment-id]').length;
        if (countEl) countEl.textContent = remaining > 0 ? `（${remaining}件）` : '';
      }
    });
  });
}
(window as any).__enableCommentDelete = showCommentDeleteButtons;

async function loadComments() {
  if (!productId) return;
  const res = await fetch(`/api/comments?product_id=${productId}`).catch(() => null);
  if (!res?.ok) return;
  const json = await res.json();
  const list = document.getElementById('comment-list');
  const countEl = document.getElementById('comment-count');
  if (!list) return;
  list.innerHTML = '';
  const comments: any[] = json.comments ?? [];
  // お客様コメント数（管理者返信は除く）
  const customerCount = comments.filter(c => !c.is_admin).length;
  if (countEl) countEl.textContent = customerCount > 0 ? `（${customerCount}件）` : '';
  const mobileCountEl = document.getElementById('comment-count-mobile');
  if (mobileCountEl) mobileCountEl.textContent = customerCount > 0 ? String(customerCount) : '';
  const desktopBtnCountEl = document.getElementById('comment-count-desktop-btn');
  if (desktopBtnCountEl) desktopBtnCountEl.textContent = customerCount > 0 ? String(customerCount) : '';

  // スレッド形式で表示：親コメントの直下に返信をネスト
  const topLevel = comments.filter(c => !c.in_reply_to);
  const repliesMap: Record<string, any[]> = {};
  comments.filter(c => c.in_reply_to).forEach(c => {
    if (!repliesMap[c.in_reply_to]) repliesMap[c.in_reply_to] = [];
    repliesMap[c.in_reply_to].push(c);
  });

  topLevel.forEach(c => {
    list.appendChild(buildCommentEl(c));
    // 返信をインデントして直下に表示
    (repliesMap[c.id] ?? []).forEach(reply => {
      const wrapper = document.createElement('div');
      wrapper.className = 'ml-6 pl-3 border-l-2 border-[var(--primary)] border-opacity-30 mt-2';
      wrapper.appendChild(buildCommentEl(reply));
      list.appendChild(wrapper);
    });
  });

  if (_adminToken) showCommentDeleteButtons(_adminToken);
  checkReplyNotify(comments);
}

// ── 返信通知バナー ──
function checkReplyNotify(comments: any[]) {
  if (!productId) return;
  // 出品者（管理者）は自分の返信を通知しない
  if (_isAdmin) return;
  try {
    const MY_KEY = 'my_commented_products';
    const SEEN_KEY = `notif_seen_${productId}`;
    const myList = JSON.parse(localStorage.getItem(MY_KEY) || '[]') as {id:string, at:string}[];
    const myRecord = myList.find(p => p.id === productId);
    if (!myRecord) return;

    const lastSeen = localStorage.getItem(SEEN_KEY) ?? myRecord.at;
    const dismissed = localStorage.getItem(SEEN_KEY + '_dismissed');
    if (dismissed) return;

    const toMs = (iso: string) => new Date(iso).getTime();

    // 自分のコメント投稿後に管理者返信があるか
    const adminReplies = comments.filter(c => c.is_admin && toMs(c.created_at) > toMs(myRecord.at));
    if (adminReplies.length === 0) return;

    // lastSeen以降に新しい返信があるか
    const hasNew = adminReplies.some(c => toMs(c.created_at) > toMs(lastSeen));
    if (!hasNew) return;

    // 最新の返信者名を取得
    const latestReply = adminReplies.sort((a, b) => toMs(b.created_at) - toMs(a.created_at))[0];
    const replierName = latestReply?.name && latestReply.name !== '匿名'
      ? latestReply.name
      : '出品者';

    // バナーのテキストを更新
    const banner = document.getElementById('reply-notify-banner');
    const bannerTitle = document.getElementById('reply-notify-title');
    if (bannerTitle) bannerTitle.textContent = `${replierName}から返信があります`;
    if (banner) banner.classList.remove('hidden');

    const closeBtn = document.getElementById('reply-notify-close');
    closeBtn?.addEventListener('click', () => {
      banner?.classList.add('hidden');
      localStorage.setItem(SEEN_KEY + '_dismissed', '1');
    }, { once: true });
  } catch {}
}

loadComments().then(() => {
  const hash = window.location.hash;
  if (hash.startsWith('#comment-')) {
    const target = document.getElementById(hash.slice(1));
    if (target) {
      setTimeout(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target.classList.add('ring-2', 'ring-[var(--primary)]', 'ring-offset-2', 'transition-all');
        setTimeout(() => target.classList.remove('ring-2', 'ring-[var(--primary)]', 'ring-offset-2'), 3000);
      }, 300);
    }
  }
});

// ── Supabase Realtime: コメントをリアルタイム更新 ──
(async () => {
  if (!productId) return;

  // トースト通知UI
  function showCommentToast(isAdmin: boolean) {
    const existing = document.getElementById('comment-toast');
    existing?.remove();
    const toast = document.createElement('div');
    toast.id = 'comment-toast';
    toast.className = [
      'fixed bottom-24 left-1/2 -translate-x-1/2 z-50',
      'flex items-center gap-2 rounded-full shadow-lg px-5 py-2.5 text-sm font-medium text-white',
      'animate-[fadeInUp_0.3s_ease]',
      isAdmin ? 'bg-[var(--primary)]' : 'bg-stone-700',
    ].join(' ');
    toast.innerHTML = isAdmin
      ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> 出品者からコメントが届きました`
      : `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> 新しいコメントが届きました`;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.4s'; setTimeout(() => toast.remove(), 400); }, 3500);
  }

  // Supabase Realtimeチャンネル購読
  const { supabase: realtimeClient } = await import('../../lib/supabaseClient');
  let lastKnownIds = new Set(
    Array.from(document.querySelectorAll<HTMLElement>('#comment-list [data-comment-id]')).map(el => el.dataset.commentId!)
  );

  realtimeClient
    .channel(`product-comments-${productId}`)
    .on('postgres_changes', {
      event: 'INSERT',
      schema: 'public',
      table: 'product_comments',
      filter: `product_id=eq.${productId}`,
    }, async (payload: any) => {
      const newId = payload.new?.id;
      if (!newId || lastKnownIds.has(newId)) return; // 自分の投稿は二重表示しない
      lastKnownIds.add(newId);
      await loadComments();
      showCommentToast(!!payload.new?.is_admin);
    })
    .subscribe();
})();

