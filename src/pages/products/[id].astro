        {product.product_type !== 'digital' && (
          <span>{product.shipping_payer?.includes('出品者') ? '送料込み' : product.shipping_payer ? '着払い' : ''}</span>
        )}
        {reviews.length > 0 && (
          <>
            <span class="text-stone-300">·</span>
            <span class="text-[var(--star)]">★</span>
            <span class="font-semibold text-stone-600">{ratingRounded}</span>
            <span>({reviews.length}件)</span>
          </>
        )}
      </div>
    </div>
    <!-- Like icon -->
    <button id="like-btn-mobile"
      class="inline-flex items-center gap-1 h-9 px-2.5 rounded-full border border-stone-200 text-stone-500 hover:text-red-400 hover:border-red-300 transition-colors shrink-0"
      aria-label="いいね"
    >
      <svg id="like-icon-mobile" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span id="like-count-mobile" class="text-xs font-bold">{product.likes_count ?? 0}</span>
    </button>
    <!-- Comment icon -->
    <button
      onclick="document.getElementById('product-comments')?.scrollIntoView({behavior:'smooth'})"
      class="inline-flex items-center justify-center gap-1 h-9 min-w-[2.25rem] px-2 rounded-full border border-stone-200 text-stone-500 hover:text-stone-700 hover:border-stone-300 transition-colors shrink-0"
      aria-label="コメント"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span id="comment-count-mobile" class="text-xs font-bold leading-none"></span>
    </button>
    <!-- LINE button (デジタル商品のみ) -->
    {product.product_type === 'digital' && (
      <button
        id="line-btn-mobile"
        type="button"
        aria-label="LINEで問い合わせる"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-[#06C755] transition hover:opacity-80 shrink-0"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      </button>
    )}
    <!-- Buy button (モバイル) -->
    <div id="mobile-buy-area" class="shrink-0">
      {isSoldOut ? (
        <button disabled class="rounded-full bg-[var(--border)] text-[var(--text-secondary)] h-[44px] px-5 text-sm font-semibold cursor-not-allowed">
          SOLD OUT
        </button>
      ) : (
        <button
          class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--primary)] text-white h-[44px] px-3 text-[12px] font-semibold tracking-wide transition-colors hover:bg-[var(--primary-hover)] active:scale-[0.98] sm:px-5 sm:text-sm"
          data-checkout
          data-product-id={product.id}
          data-title={product.title}
          data-price={product.price}
          data-mode={product.is_subscription ? 'subscription' : 'payment'}
          data-seller-name={profile?.display_name ?? ''}
          data-thumbnail={product.thumbnail_url ?? ''}
          data-stock={product.stock ?? ''}
        >
          <svg width="15" height="15" viewBox="0 0 21 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.785 1.68C0.785 1.184 1.188.781 1.685.781H3.343c.915 0 1.724.601 1.992 1.481l2.68 9.85c.13.48-.153.975-.632 1.105-.48.13-.975-.153-1.105-.632L3.61 2.779C3.57 2.656 3.458 2.581 3.343 2.581H1.685C1.188 2.581.785 2.178.785 1.681Z" fill="#fff"/>
            <circle cx="8.446" cy="19.674" r="1.688" fill="#fff"/>
            <circle cx="16.376" cy="19.674" r="1.688" fill="#fff"/>
            <path d="M4.574 4.474a.9.9 0 0 1 .9-.9h13.904c.271 0 .528.123.699.334.17.211.237.488.18.754l-1.406 6.596c-.078.368-.376.648-.747.702l-.428.063c-.272.04-.663.1-1.133.17-1.858.277-4.438.682-6.538 1.014l-.07.013c-.253.05-.522.116-.687.161-.053.016-.075.024-.075.024l-.004.002c-.268.123-.443.383-.443.683 0 .41.342.754.758.754H18.015a.9.9 0 1 1 0 1.8H7.33c-1.407 0-2.558-1.146-2.558-2.554 0-1.035.614-1.914 1.487-2.317.203-.095.475-.162.62-.196l.343-.077C7.638 11.726 10.298 11.317 12.79 10.94l.943-.14 1.044-4.926H5.474a.9.9 0 0 1-.9-.9Z" fill="#fff"/>
          </svg>
          {product.is_subscription ? '申し込む' : 'felikko.comで購入する'}
        </button>
      )}
      <!-- オーナー用編集ボタン（モバイル）→ JSで表示切替 -->
      <a id="owner-edit-btn-mobile"
        href={`/dashboard/products/${product.id}`}
        class="hidden items-center justify-center gap-1.5 rounded-full border-2 border-[var(--primary)] text-[var(--primary)] h-[44px] px-5 text-sm font-semibold tracking-wide transition-colors hover:bg-[var(--primary)] hover:text-white"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        編集
      </a>
    </div>
  </div>
</div>

<!-- Purchase Success Modal -->
