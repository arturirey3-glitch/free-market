// Form submit
const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
const commentSubmit = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;
const commentSuccess = document.getElementById('comment-success');
const commentError = document.getElementById('comment-error');

commentForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!commentSubmit) return;
  const message = (document.getElementById('comment-message') as HTMLTextAreaElement).value.trim();
  if (!message) return;

  commentSubmit.disabled = true;
  commentSubmit.textContent = '送信中...';
  commentSuccess?.classList.add('hidden');
  commentError?.classList.add('hidden');

  try {
    const res = await fetch('/api/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ product_id: productId, product_title: productTitle, product_url: productUrl, message, name: nameInput?.value.trim() || _loggedInName || undefined, access_token: _accessToken || undefined }),
    });
    if (res.ok) {
      commentSuccess?.classList.remove('hidden');
      const savedName = nameInput?.value ?? '';
      commentForm.reset();
      if (nameInput) { nameInput.value = savedName; updateAvatar(savedName); } // 名前は残す
      if (charEl) charEl.textContent = '0';

      // コメントした商品・時刻をlocalStorageに記録（返信通知用）
      try {
        const MY_KEY = 'my_commented_products';
        const list = JSON.parse(localStorage.getItem(MY_KEY) || '[]') as {id:string,at:string}[];
        const existing = list.find(p => p.id === productId);
        const now = new Date().toISOString();
        if (existing) { existing.at = now; } else { list.push({ id: productId, at: now }); }
        localStorage.setItem(MY_KEY, JSON.stringify(list.slice(-50))); // 最大50件
        // 通知バナーを非表示に（自分のコメント直後なので）
        document.getElementById('reply-notify-banner')?.classList.add('hidden');
        localStorage.setItem(`notif_seen_${productId}`, now);
        localStorage.removeItem(`notif_seen_${productId}_dismissed`); // 再コメント時は通知リセット
      } catch {}

      await loadComments();
    } else {
      commentError?.classList.remove('hidden');
    }
  } catch {
    commentError?.classList.remove('hidden');
  } finally {
    commentSubmit.disabled = false;
    commentSubmit.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> コメントを送る`;
  }
});

