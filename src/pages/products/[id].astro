// お名前入力でアバターをリアルタイム更新
const nameInput = document.getElementById('comment-name') as HTMLInputElement | null;
const avatarEl = document.getElementById('comment-avatar-preview');
const AVATAR_COLORS_FORM = ['#ef4444','#f97316','#eab308','#22c55e','#14b8a6','#3b82f6','#8b5cf6','#ec4899','#6366f1','#10b981'];
function getAvatarColor(name: string) {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
  return AVATAR_COLORS_FORM[Math.abs(h) % AVATAR_COLORS_FORM.length];
}
function updateAvatar(name: string) {
  if (!avatarEl) return;
  if (name.trim()) {
    const color = getAvatarColor(name.trim());
    avatarEl.style.backgroundColor = color;
    avatarEl.style.color = '#fff';
    avatarEl.innerHTML = `<span>${Array.from(name.trim())[0].toUpperCase()}</span>`;
  } else {
    avatarEl.style.backgroundColor = '';
    avatarEl.style.color = '';
    avatarEl.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>`;
  }
}
