      LINEで問い合わせる
    </a>
    <button id="purchase-modal-close" class="mt-3 w-full rounded-full border border-stone-200 py-2.5 text-sm font-semibold text-stone-600 hover:bg-stone-50">
      閉じる
    </button>
  </div>
</div>

