---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Toast from '../../../components/Toast.astro';
---
<BaseLayout title="出品した商品 | felikko">
  <Toast />
  <div class="mx-auto max-w-[960px] px-4 py-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-lg font-bold">出品した商品</h1>
      <a href="/dashboard/products/new" class="btn-primary text-sm py-2 px-4">＋ 新規出品</a>
    </div>

    <!-- 並び替えヒント -->
    <p id="sort-hint" class="hidden mb-3 text-xs text-[var(--text-secondary)]">
      ⠿ をドラッグして並び替えできます。番号をクリックすると位置を直接指定できます。順番は自動で保存されます。
    </p>

    <div id="products-list">
      <p class="text-sm text-[var(--text-secondary)]">読み込み中...</p>
    </div>
  </div>

  <!-- SortableJS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

  <script>
  import { supabase } from '../../../lib/supabaseClient';

  declare global {
    interface Window {
      showToast: (type: 'success' | 'error' | 'info', title: string, message: string) => void;
      Sortable: any;
    }
  }

  const container = document.getElementById('products-list')!;
  const hint = document.getElementById('sort-hint')!;

  const { data: sessionData } = await supabase.auth.getSession();
  if (!sessionData.session) { window.location.href = '/auth/login'; }

  const { data, error } = await supabase
    .from('products')
    .select('id,title,price,status,thumbnail_url,created_at,sort_order,is_pickup,trial_enabled,trial_days,is_subscription,product_type')
    .eq('owner_id', sessionData.session!.user.id)
    .order('sort_order', { ascending: true, nullsFirst: false })
    .order('created_at', { ascending: false });

  if (error || !data || data.length === 0) {
    container.innerHTML = `
      <div class="flex flex-col items-center justify-center py-16 text-center">
        <p class="text-sm text-[var(--text-secondary)]">出品した商品はまだありません</p>
        <a href="/dashboard/products/new" class="btn-primary mt-4 text-sm py-2 px-5">最初の商品を出品する</a>
      </div>
    `;
  } else {
    hint.classList.remove('hidden');

    container.innerHTML = `
      <!-- 一括でお試し対象を切り替えるバー -->
      <div class="card mb-3 flex flex-wrap items-center gap-3 p-3">
        <label class="flex items-center gap-2 text-xs font-medium">
          <input type="checkbox" id="trial-select-all" class="accent-[var(--primary)]" />
          すべて選択
        </label>
        <span id="trial-selected-count" class="text-xs text-[var(--text-secondary)]">0件選択中</span>
        <div class="ml-auto flex items-center gap-2">
          <label for="trial-bulk-days" class="text-xs text-[var(--text-secondary)]">お試し</label>
          <input type="number" id="trial-bulk-days" min="1" max="20" value="7" class="input-field w-16 text-xs py-1" />
          <span class="text-xs text-[var(--text-secondary)]">日</span>
          <button id="trial-enable-btn" class="btn-primary text-xs py-1.5 px-3" disabled>お試しを有効化</button>
          <button id="trial-disable-btn" class="btn-outline text-xs py-1.5 px-3" disabled>無効化</button>
        </div>
      </div>

      <div id="sortable-list" class="space-y-2">
        ${data.map((p: any, i: number) => `
          <div class="card flex items-center gap-3 p-3 cursor-default" data-id="${p.id}">
            <!-- 一括選択（お試し対象の切り替え用）。サブスク・デジタル商品は対象外 -->
            <input type="checkbox" class="trial-select accent-[var(--primary)] shrink-0 disabled:opacity-30"
              data-id="${p.id}" ${p.is_subscription || p.product_type === 'digital' ? 'disabled title="サブスク・デジタル商品はお試し対象外です"' : ''} />
            <!-- ドラッグハンドル -->
            <div class="drag-handle cursor-grab active:cursor-grabbing text-[var(--text-placeholder)] select-none px-1 shrink-0 text-lg" title="ドラッグして並び替え">⠿</div>
            <!-- 順番 -->
            <span class="item-order shrink-0 w-6 text-center text-xs font-bold text-[var(--text-secondary)] cursor-pointer hover:underline hover:text-[var(--primary)]" title="クリックで位置変更">${i + 1}</span>
            <!-- サムネイル -->
            <div class="h-14 w-14 shrink-0 rounded-lg bg-[var(--bg-secondary)] overflow-hidden">
              ${p.thumbnail_url
                ? `<img src="${p.thumbnail_url}" class="h-full w-full object-cover" />`
                : '<div class="h-full w-full flex items-center justify-center text-[var(--text-placeholder)] text-xl">📷</div>'}
            </div>
            <!-- 商品情報 -->
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate">${p.title}</p>
              <span class="inline-block mt-0.5 rounded px-1.5 py-0.5 text-[10px] font-medium ${p.status === 'published' ? 'bg-[var(--primary-light)] text-[var(--primary)]' : 'bg-[var(--bg-secondary)] text-[var(--text-secondary)]'}">
                ${p.status === 'published' ? '公開中' : '下書き'}
              </span>
              ${p.trial_enabled ? `<span class="trial-badge inline-block mt-0.5 ml-1 rounded px-1.5 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-700">🎁 ${p.trial_days ?? 7}日お試し</span>` : ''}
            </div>
            <p class="text-sm font-bold shrink-0">¥${Number(p.price).toLocaleString()}</p>
            <div class="flex gap-2 shrink-0">
              <button class="pickup-btn shrink-0 rounded border px-2 py-1 text-xs font-medium transition ${p.is_pickup ? 'border-amber-400 bg-amber-50 text-amber-600' : 'border-[var(--border)] text-[var(--text-secondary)] hover:border-amber-400 hover:text-amber-500'}" data-id="${p.id}" data-pickup="${p.is_pickup ? '1' : '0'}">${p.is_pickup ? '⭐ 固定中' : '☆ 固定'}</button>
              <a href="/dashboard/products/${p.id}" class="btn-outline text-xs py-1 px-2">編集</a>
              <button class="btn-danger text-xs py-1 px-2" data-delete="${p.id}">削除</button>
            </div>
          </div>
        `).join('')}
      </div>
    `;

    // 順番表示を更新する関数
    function updateOrderNumbers() {
      const items = document.querySelectorAll<HTMLElement>('#sortable-list > [data-id]');
      items.forEach((el, i) => {
        const orderEl = el.querySelector('.item-order');
        if (orderEl) orderEl.textContent = String(i + 1);
      });
    }

    // Supabase に sort_order を一括保存する関数
    async function saveSortOrder() {
      const items = document.querySelectorAll<HTMLElement>('#sortable-list > [data-id]');
      const updates = Array.from(items).map((el, i) => ({
        id: el.dataset.id!,
        sort_order: i + 1,
      }));

      // 各アイテムを個別に update（Supabase REST は upsert で一括可）
      const promises = updates.map(({ id, sort_order }) =>
        supabase.from('products').update({ sort_order }).eq('id', id)
      );
      const results = await Promise.all(promises);
      const failed = results.filter(r => r.error);
      if (failed.length > 0) {
        window.showToast?.('error', '保存失敗', '並び替えの保存に失敗しました');
      } else {
        window.showToast?.('success', '保存しました', '並び順を更新しました');
      }
    }

    // SortableJS 初期化（CDN が読み込まれてから）
    function initSortable() {
      const list = document.getElementById('sortable-list');
      if (!list || !window.Sortable) return;

      window.Sortable.create(list, {
        handle: '.drag-handle',
        animation: 150,
        ghostClass: 'opacity-40',
        onEnd: async () => {
          updateOrderNumbers();
          await saveSortOrder();
        },
      });
    }

    // CDN 読み込み待ち
    if (window.Sortable) {
      initSortable();
    } else {
      document.querySelector('script[src*="Sortable"]')?.addEventListener('load', initSortable);
      // fallback: poll
      let tries = 0;
      const poll = setInterval(() => {
        if (window.Sortable || ++tries > 20) { clearInterval(poll); initSortable(); }
      }, 100);
    }

    // 順番クリックで位置指定移動（イベントデリゲーション）
    document.getElementById('sortable-list')!.addEventListener('click', (e) => {
      const span = (e.target as HTMLElement).closest<HTMLElement>('.item-order');
      if (!span || span.tagName !== 'SPAN') return;

      const list = document.getElementById('sortable-list')!;
      const row = span.closest<HTMLElement>('[data-id]');
      if (!row) return;

      const allItems = () => Array.from(list.querySelectorAll<HTMLElement>(':scope > [data-id]'));
      const currentIdx = allItems().indexOf(row);
      const currentNum = currentIdx + 1;
      const total = allItems().length;
      const spanClass = span.className;
      const spanTitle = span.title;

      const input = document.createElement('input');
      input.type = 'number';
      input.min = '1';
      input.max = String(total);
      input.value = String(currentNum);
      input.className = 'w-10 text-center text-xs font-bold border border-[var(--primary)] rounded outline-none';
      span.replaceWith(input);
      input.focus();
      input.select();

      let committed = false;
      const commit = async () => {
        if (committed) return;
        committed = true;

        const val = parseInt(input.value, 10);

        // inputをspanに戻す
        const newSpan = document.createElement('span');
        newSpan.className = spanClass;
        newSpan.title = spanTitle;
        newSpan.textContent = String(currentNum);
        if (input.parentNode) input.replaceWith(newSpan);

        // 無効値なら何もしない
        if (isNaN(val) || val < 1 || val > total || val === currentNum) return;

        // rowのDOM上の現在位置を取得（inputがspanに戻った後なので正確）
        const items = allItems();
        const fromIdx = items.indexOf(row);
        if (fromIdx === -1) return;
        const toIdx = val - 1;

        // DOM移動
        if (toIdx < fromIdx) {
          list.insertBefore(row, items[toIdx]);
        } else {
          const ref = items[toIdx];
          list.insertBefore(row, ref.nextSibling ?? null);
        }

        // 番号更新 & 保存
        updateOrderNumbers();
        await saveSortOrder();
      };

      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); input.blur(); } });
      input.addEventListener('blur', commit);
    });

    // ── 無料お試しの一括設定 ──────────────────────────────────
    const selectAll = document.getElementById('trial-select-all') as HTMLInputElement;
    const countLabel = document.getElementById('trial-selected-count')!;
    const bulkDays = document.getElementById('trial-bulk-days') as HTMLInputElement;
    const enableBtn = document.getElementById('trial-enable-btn') as HTMLButtonElement;
    const disableBtn = document.getElementById('trial-disable-btn') as HTMLButtonElement;
    const boxes = () => Array.from(container.querySelectorAll<HTMLInputElement>('.trial-select:not(:disabled)'));
    const selectedIds = () => boxes().filter(b => b.checked).map(b => b.dataset.id!);

    function refreshSelection() {
      const n = selectedIds().length;
      countLabel.textContent = `${n}件選択中`;
      enableBtn.disabled = n === 0;
      disableBtn.disabled = n === 0;
      const all = boxes();
      selectAll.checked = all.length > 0 && n === all.length;
      selectAll.indeterminate = n > 0 && n < all.length;
    }

    selectAll.addEventListener('change', () => {
      boxes().forEach(b => { b.checked = selectAll.checked; });
      refreshSelection();
    });
    boxes().forEach(b => b.addEventListener('change', refreshSelection));

    async function applyTrial(enabled: boolean) {
      const ids = selectedIds();
      if (!ids.length) return;
      const days = Math.min(20, Math.max(1, Number(bulkDays.value) || 7));
      enableBtn.disabled = true; disableBtn.disabled = true;
      const patch = enabled ? { trial_enabled: true, trial_days: days } : { trial_enabled: false };
      const { error } = await supabase.from('products').update(patch).in('id', ids);
      if (error) {
        window.showToast?.('error', 'エラー', error.message);
        refreshSelection();
        return;
      }
      // バッジを描き直す（再読み込みなしで結果が見えるように）
      ids.forEach(id => {
        const row = container.querySelector<HTMLElement>(`[data-id="${id}"]`);
        const info = row?.querySelector('.flex-1');
        row?.querySelector('.trial-badge')?.remove();
        if (enabled && info) {
          info.insertAdjacentHTML('beforeend',
            `<span class="trial-badge inline-block mt-0.5 ml-1 rounded px-1.5 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-700">🎁 ${days}日お試し</span>`);
        }
      });
      window.showToast?.('success', '更新しました',
        enabled ? `${ids.length}件を${days}日間のお試し対象にしました` : `${ids.length}件のお試しを解除しました`);
      refreshSelection();
    }

    enableBtn.addEventListener('click', () => applyTrial(true));
    disableBtn.addEventListener('click', () => applyTrial(false));
    refreshSelection();

    // ピックアップトグル
    container.querySelectorAll<HTMLButtonElement>('.pickup-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id!;
        const current = btn.dataset.pickup === '1';
        const next = !current;
        btn.disabled = true;
        const { error } = await supabase.from('products').update({ is_pickup: next }).eq('id', id);
        if (error) {
          window.showToast?.('error', 'エラー', error.message);
        } else {
          btn.dataset.pickup = next ? '1' : '0';
          btn.textContent = next ? '⭐ 固定中' : '☆ 固定';
          if (next) {
            btn.className = btn.className.replace('border-[var(--border)] text-[var(--text-secondary)] hover:border-amber-400 hover:text-amber-500', 'border-amber-400 bg-amber-50 text-amber-600');
          } else {
            btn.className = btn.className.replace('border-amber-400 bg-amber-50 text-amber-600', 'border-[var(--border)] text-[var(--text-secondary)] hover:border-amber-400 hover:text-amber-500');
          }
          window.showToast?.('success', next ? 'ピックアップに追加しました' : 'ピックアップを解除しました', '');
        }
        btn.disabled = false;
      });
    });

    // 削除ボタン
    container.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('この商品を削除してよいですか？')) return;
        const id = btn.dataset.delete!;
        btn.disabled = true;
        const { error } = await supabase.from('products').delete().eq('id', id);
        if (error) {
          window.showToast?.('error', 'エラー', error.message);
          btn.disabled = false;
        } else {
          btn.closest('[data-id]')?.remove();
          updateOrderNumbers();
          window.showToast?.('success', '削除しました', '');
          if (!container.querySelector('[data-id]')) {
            hint.classList.add('hidden');
            container.innerHTML = `<div class="flex flex-col items-center justify-center py-16 text-center"><p class="text-sm text-[var(--text-secondary)]">出品した商品はまだありません</p><a href="/dashboard/products/new" class="btn-primary mt-4 text-sm py-2 px-5">最初の商品を出品する</a></div>`;
          }
        }
      });
    });
  }
  </script>
</BaseLayout>
