---
import globalStyles from '../styles/global.css?url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogUrl?: string;
  ogType?: string;
  jsonLd?: string;
}

const { title = 'felikko | スタバ・マリメッコ雑貨のフリマ通販', description = 'felikkoはスタバグッズ・マリメッコ・北欧インテリア雑貨を中心としたフリマ通販サイト。即購入OK・送料込みで安心お買い物。', ogImage, ogImageWidth = 1200, ogImageHeight = 630, ogUrl, ogType = 'website', jsonLd } = Astro.props;
const siteUrl = 'https://www.felikko.com';
const canonicalUrl = ogUrl || siteUrl + Astro.url.pathname;
const GA_ID = import.meta.env.GA_MEASUREMENT_ID || '';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="stylesheet" href={globalStyles} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="felikko" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImage && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <!-- Google Analytics 4 -->
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
    {jsonLd && <Fragment set:html={`<script type="application/ld+json">${jsonLd}</script>`} />}
    <!-- 事業者情報（Organization）: ビジネスアイデンティティの透明性 -->
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'OnlineStore',
      name: 'felikko',
      legalName: '本田 ケビン',
      founder: { '@type': 'Person', name: '本田 ケビン' },
      url: siteUrl,
      logo: `${siteUrl}/favicon-192x192.png`,
      image: `${siteUrl}/favicon-192x192.png`,
      email: 'support@felikko.com',
      telephone: '+81-50-1743-9431',
      address: {
        '@type': 'PostalAddress',
        postalCode: '350-1305',
        addressRegion: '埼玉県',
        addressLocality: '狭山市',
        streetAddress: '入間川3丁目4-3 グランドレジデンス・狭山 202',
        addressCountry: 'JP',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+81-50-1743-9431',
        email: 'support@felikko.com',
        contactType: 'customer service',
        availableLanguage: ['Japanese'],
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
          opens: '10:00',
          closes: '17:00',
        },
      },
    })}</script>`} />
    <slot name="head" />
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <!-- Header -->
      <header class="sticky top-0 z-40 bg-white border-b border-[var(--border-light)]">
        <div class="mx-auto flex max-w-[1440px] items-center justify-between px-4 h-16">
          <a href="/" class="shrink-0">
            <img src="/felikko-logo.png" alt="felikko" class="h-11 w-auto" />
          </a>

          <!-- Search -->
          <div class="hidden sm:flex flex-1 max-w-md mx-6">
            <form action="/products" method="get" class="flex w-full">
              <input
                type="text"
                name="q"
                placeholder="なにをお探しですか？"
                class="flex-1 rounded-l-full border border-r-0 border-[var(--border)] px-4 py-2 text-sm outline-none focus:border-[var(--primary)]"
              />
              <button type="submit" class="rounded-r-full bg-[var(--primary)] px-4 text-white text-sm font-bold">
                検索
              </button>
            </form>
          </div>

          <nav class="flex items-center gap-3 text-sm font-medium">
            <a href="/products" class="hidden md:block hover:text-[var(--primary)]">商品一覧</a>
            <a href="/custom-order" class="hidden md:block font-bold text-[var(--primary)] hover:opacity-80">オーダーメイド</a>
            <a href="/dashboard" class="hidden md:block hover:text-[var(--primary)]">マイページ</a>
            <!-- Customer: notification bell -->
            <div id="customer-notif-wrap" class="relative hidden">
              <button id="customer-notif-bell" type="button"
                class="relative flex items-center justify-center w-9 h-9 rounded-full text-[var(--text-secondary)] hover:bg-stone-100 hover:text-[var(--text-primary)] transition"
                aria-label="通知"
              >
                <svg width="22" height="22" class="fill-current" fill-rule="evenodd" viewBox="0 0 24 24"><path d="M20.35,16h0L17.9,14a.28.28,0,0,1-.11-.23V9.25A5.76,5.76,0,0,0,14.2,3.94a2.22,2.22,0,0,0-4.4,0A5.76,5.76,0,0,0,6.21,9.25V13.8A.28.28,0,0,1,6.1,14L3.65,16A1.7,1.7,0,0,0,4.7,19H8.32a3.76,3.76,0,0,0,7.36,0H19.3a1.7,1.7,0,0,0,1.05-3ZM12,20.6A2.35,2.35,0,0,1,9.76,19h4.48A2.35,2.35,0,0,1,12,20.6Zm7.58-3.19a.28.28,0,0,1-.28.2H4.7a.28.28,0,0,1-.28-.2.27.27,0,0,1,.1-.33L7,15.13a1.68,1.68,0,0,0,.64-1.33V9.25a4.39,4.39,0,0,1,8.78,0V13.8A1.68,1.68,0,0,0,17,15.13l2.45,1.95A.27.27,0,0,1,19.58,17.41Z"/></svg>
                <span id="customer-notif-badge" class="hidden absolute top-1 right-1 w-2 h-2 rounded-full bg-red-500"></span>
              </button>
              <!-- Dropdown -->
              <div id="customer-notif-dropdown"
                class="hidden z-50 overflow-hidden bg-white rounded-2xl shadow-[0_8px_32px_rgba(0,0,0,0.14)] border border-[var(--border-light)]
                       fixed left-3 right-3 top-[68px]
                       sm:absolute sm:left-auto sm:right-0 sm:top-11 sm:w-80 sm:inset-[unset]"
              >
                <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border-light)]">
                  <span class="text-sm font-semibold text-stone-800">返信通知</span>
                  <button id="customer-notif-mark-read" class="text-xs text-[var(--primary)] hover:underline">すべて既読</button>
                </div>
                <div id="customer-notif-list" class="max-h-[420px] overflow-y-auto divide-y divide-[var(--border-light)]">
                  <div class="flex items-center justify-center py-10 text-sm text-stone-400">読み込み中...</div>
                </div>
              </div>
            </div>
            <!-- Admin: notification bell -->
            <div id="admin-notif-wrap" class="relative hidden">
              <button id="admin-notif-bell" type="button"
                class="relative flex items-center justify-center w-9 h-9 rounded-full text-[var(--text-secondary)] hover:bg-stone-100 hover:text-[var(--text-primary)] transition"
                aria-label="通知"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <!-- Unread badge -->
                <span id="notif-badge" class="hidden absolute top-1 right-1 w-2 h-2 rounded-full bg-red-500"></span>
              </button>

              <!-- Dropdown -->
              <div id="notif-dropdown"
                class="hidden z-50 overflow-hidden bg-white rounded-2xl shadow-[0_8px_32px_rgba(0,0,0,0.14)] border border-[var(--border-light)]
                       fixed left-3 right-3 top-[68px]
                       sm:absolute sm:left-auto sm:right-0 sm:top-11 sm:w-80 sm:inset-[unset]"
              >
                <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border-light)]">
                  <span class="text-sm font-semibold text-stone-800">通知</span>
                  <button id="notif-mark-read" class="text-xs text-[var(--primary)] hover:underline">すべて既読</button>
                </div>
                <div id="notif-list" class="max-h-[420px] overflow-y-auto divide-y divide-[var(--border-light)]">
                  <div class="flex items-center justify-center py-10 text-sm text-stone-400">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mr-2 opacity-50"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    読み込み中...
                  </div>
                </div>
              </div>
            </div>
            <a href="/auth/login" class="hover:text-[var(--primary)]" data-auth-login>ログイン</a>
            <button type="button" class="hidden hover:text-[var(--primary)]" data-auth-logout>ログアウト</button>
            <a href="/dashboard/products/new" class="btn-primary">出品</a>
          </nav>
        </div>
        <!-- Mobile search -->
        <div class="sm:hidden px-4 pb-3">
          <form action="/products" method="get" class="flex">
            <input
              type="text"
              name="q"
              placeholder="なにをお探しですか？"
              class="flex-1 rounded-l-full border border-r-0 border-[var(--border)] px-4 py-2 text-sm outline-none"
            />
            <button type="submit" class="rounded-r-full bg-[var(--primary)] px-4 text-white text-sm font-bold">
              検索
            </button>
          </form>
        </div>
      </header>

      <!-- Main -->
      <main class="flex-1">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="border-t border-[var(--border-light)] bg-[var(--bg-secondary)] py-8 pb-safe">
        <div class="mx-auto max-w-[1440px] px-4 text-xs text-[var(--text-secondary)]">
          <ul class="grid grid-cols-2 gap-x-6 gap-y-3 mb-5 sm:flex sm:flex-wrap sm:gap-6 sm:gap-y-2">
            <li><a href="/about" class="hover:text-[var(--text-primary)] py-1 block">ショップについて</a></li>
            <li><a href="/privacy" class="hover:text-[var(--text-primary)] py-1 block">プライバシーポリシー</a></li>
            <li><a href="/law" class="hover:text-[var(--text-primary)] py-1 block">特定商取引法に基づく表記</a></li>
            <li><a href="/contact" class="hover:text-[var(--text-primary)] py-1 block">お問い合わせ</a></li>
          </ul>
          <p>&copy; 2026 <a href="https://www.felikko.com" class="hover:text-[var(--text-primary)]">felikko</a></p>
        </div>
      </footer>
    </div>

    <script>
    import { supabase } from '../lib/supabaseClient';

    const loginLinks = document.querySelectorAll('[data-auth-login]');
    const logoutButtons = document.querySelectorAll('[data-auth-logout]');

    const setAuthUI = (isLoggedIn: boolean) => {
      loginLinks.forEach((el) => el.classList.toggle('hidden', isLoggedIn));
      logoutButtons.forEach((el) => el.classList.toggle('hidden', !isLoggedIn));
    };

    const { data } = await supabase.auth.getSession();
    setAuthUI(!!data.session);

    // Admin: notification bell + dropdown
    if (data.session) {
      const { data: adminProfile } = await supabase
        .from('profiles').select('is_admin').eq('id', data.session.user.id).single();
      if (adminProfile?.is_admin) {
        const wrap = document.getElementById('admin-notif-wrap');
        wrap?.classList.replace('hidden', 'flex');

        const bell = document.getElementById('admin-notif-bell');
        const dropdown = document.getElementById('notif-dropdown');
        const list = document.getElementById('notif-list');
        const badge = document.getElementById('notif-badge');
        const markReadBtn = document.getElementById('notif-mark-read');
        const LAST_READ_KEY = 'notif_last_read';
        let isOpen = false;

        const fmtDate = (iso: string) => {
          const d = new Date(iso);
          const now = new Date();
          const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
          if (diff < 60) return 'たった今';
          if (diff < 3600) return `${Math.floor(diff / 60)}分前`;
          if (diff < 86400) return `${Math.floor(diff / 3600)}時間前`;
          return `${Math.floor(diff / 86400)}日前`;
        };

        const loadNotifications = async () => {
          if (!list) return;
          try {
            const res = await fetch('/api/notifications', {
              headers: { 'x-access-token': data.session!.access_token },
            });
            const json = await res.json();
            const items: any[] = json.notifications ?? [];
            const lastRead = localStorage.getItem(LAST_READ_KEY) ?? '1970-01-01';
            const unreadCount = items.filter(n => n.created_at > lastRead).length;

            if (badge) badge.classList.toggle('hidden', unreadCount === 0);

            if (items.length === 0) {
              list.innerHTML = `<div class="flex flex-col items-center justify-center py-10 text-sm text-stone-400 gap-2">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-30"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                新着通知はありません
              </div>`;
              return;
            }

            list.innerHTML = items.map(n => {
              const isUnread = n.created_at > lastRead;
              const shortId = n.product_id?.slice(0, 8) ?? '';
              const msg = n.message.length > 60 ? n.message.slice(0, 60) + '…' : n.message;
              return `<a href="/products/${shortId}#comment-${n.id}" class="flex items-start gap-3 px-4 py-3 hover:bg-stone-50 transition-colors ${isUnread ? 'bg-green-50/60' : ''}">
                ${isUnread ? '<span class="mt-1.5 w-2 h-2 rounded-full bg-[var(--primary)] shrink-0"></span>' : '<span class="mt-1.5 w-2 h-2 shrink-0"></span>'}
                <div class="flex-1 min-w-0">
                  <p class="text-[11px] text-stone-400 truncate">${n.product_title}</p>
                  <p class="text-sm text-stone-700 leading-snug mt-0.5">${msg.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</p>
                </div>
                <span class="text-[10px] text-stone-400 shrink-0 mt-0.5">${fmtDate(n.created_at)}</span>
              </a>`;
            }).join('');
          } catch {}
        };

        const openDropdown = async () => {
          isOpen = true;
          dropdown?.classList.remove('hidden');
          await loadNotifications();
        };

        const closeDropdown = () => {
          isOpen = false;
          dropdown?.classList.add('hidden');
        };

        bell?.addEventListener('click', (e) => {
          e.stopPropagation();
          isOpen ? closeDropdown() : openDropdown();
        });

        markReadBtn?.addEventListener('click', () => {
          localStorage.setItem(LAST_READ_KEY, new Date().toISOString());
          if (badge) badge.classList.add('hidden');
          // 既読ドットを消す
          list?.querySelectorAll('a').forEach(el => el.classList.remove('bg-green-50/60'));
          list?.querySelectorAll('span.bg-\\[var\\(--primary\\)\\]').forEach(el => el.classList.replace('bg-[var(--primary)]', 'bg-transparent'));
        });

        document.addEventListener('click', (e) => {
          if (isOpen && !wrap?.contains(e.target as Node)) closeDropdown();
        });

        // 初期バッジチェック
        loadNotifications();
      }
    }

    // ── カスタマー通知ベル（ログイン不問・コメント履歴がある全ユーザー）──
    (async () => {
      try {
        const MY_KEY = 'my_commented_products';
        const myList = JSON.parse(localStorage.getItem(MY_KEY) || '[]') as {id:string,at:string}[];
        const productIds = myList.map((p: any) => p.id).filter(Boolean);
        if (productIds.length === 0) return;

        const customerWrap = document.getElementById('customer-notif-wrap');
        const customerBell = document.getElementById('customer-notif-bell');
        const customerDropdown = document.getElementById('customer-notif-dropdown');
        const customerList = document.getElementById('customer-notif-list');
        const customerBadge = document.getElementById('customer-notif-badge');
        const customerMarkRead = document.getElementById('customer-notif-mark-read');
        const C_LAST_READ = 'customer_notif_last_read';

        // 管理者ベルが表示されている場合はカスタマーベルは不要
        const adminWrap = document.getElementById('admin-notif-wrap');
        if (adminWrap && !adminWrap.classList.contains('hidden')) return;

        customerWrap?.classList.replace('hidden', 'flex');

        const fmtDateC = (iso: string) => {
          const d = new Date(iso);
          const now = new Date();
          const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
          if (diff < 60) return 'たった今';
          if (diff < 3600) return `${Math.floor(diff / 60)}分前`;
          if (diff < 86400) return `${Math.floor(diff / 3600)}時間前`;
          return `${Math.floor(diff / 86400)}日前`;
        };

        const loadCustomerNotifications = async () => {
          if (!customerList) return;
          try {
            // ログイン済みなら専用APIを使用、未ログインはpublic APIを使用
            let res;
            if (data.session) {
              res = await fetch('/api/notifications/customer', {
                headers: { 'x-access-token': data.session.access_token },
              });
            } else {
              res = await fetch(`/api/notifications/public?product_ids=${productIds.join(',')}`);
            }
            const json = await res.json();

            // localStorage の投稿時刻より後の管理者返信のみ通知対象
            const toMs = (iso: string) => new Date(iso).getTime();
            const myLastByProduct: Record<string, number> = {};
            myList.forEach((p: any) => { myLastByProduct[p.id] = toMs(p.at); });

            const allItems: any[] = json.notifications ?? [];
            const items = allItems.filter((n: any) => {
              const myLast = myLastByProduct[n.product_id];
              return myLast && toMs(n.created_at) > myLast;
            });

            const lastRead = localStorage.getItem(C_LAST_READ) ?? '1970-01-01';
            const unread = items.filter((n: any) => toMs(n.created_at) > toMs(lastRead)).length;
            if (customerBadge) customerBadge.classList.toggle('hidden', unread === 0);

            if (items.length === 0) {
              customerList.innerHTML = `<div class="flex flex-col items-center justify-center py-10 text-sm text-stone-400 gap-2">
                <svg width="28" height="28" fill-rule="evenodd" viewBox="0 0 24 24" class="opacity-30 fill-current"><path d="M20.35,16h0L17.9,14a.28.28,0,0,1-.11-.23V9.25A5.76,5.76,0,0,0,14.2,3.94a2.22,2.22,0,0,0-4.4,0A5.76,5.76,0,0,0,6.21,9.25V13.8A.28.28,0,0,1,6.1,14L3.65,16A1.7,1.7,0,0,0,4.7,19H8.32a3.76,3.76,0,0,0,7.36,0H19.3a1.7,1.7,0,0,0,1.05-3ZM12,20.6A2.35,2.35,0,0,1,9.76,19h4.48A2.35,2.35,0,0,1,12,20.6Zm7.58-3.19a.28.28,0,0,1-.28.2H4.7a.28.28,0,0,1-.28-.2.27.27,0,0,1,.1-.33L7,15.13a1.68,1.68,0,0,0,.64-1.33V9.25a4.39,4.39,0,0,1,8.78,0V13.8A1.68,1.68,0,0,0,17,15.13l2.45,1.95A.27.27,0,0,1,19.58,17.41Z"/></svg>
                返信通知はありません
              </div>`;
              return;
            }

            customerList.innerHTML = items.map((n: any) => {
              const isUnread = toMs(n.created_at) > toMs(lastRead);
              const shortId = n.product_id?.slice(0, 8) ?? '';
              const msg = n.message.length > 60 ? n.message.slice(0, 60) + '…' : n.message;
              return `<a href="/products/${shortId}#comment-${n.id}" class="flex items-start gap-3 px-4 py-3 hover:bg-stone-50 transition-colors ${isUnread ? 'bg-green-50/60' : ''}">
                ${isUnread ? '<span class="mt-1.5 w-2 h-2 rounded-full bg-[var(--primary)] shrink-0"></span>' : '<span class="mt-1.5 w-2 h-2 shrink-0"></span>'}
                <div class="flex-1 min-w-0">
                  <p class="text-[11px] text-stone-400 truncate">${n.product_title}</p>
                  <p class="text-sm text-stone-700 leading-snug mt-0.5">${msg.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</p>
                </div>
                <span class="text-[10px] text-stone-400 shrink-0 mt-0.5">${fmtDateC(n.created_at)}</span>
              </a>`;
            }).join('');
          } catch {}
        };

        let cIsOpen = false;
        customerBell?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (cIsOpen) {
            cIsOpen = false; customerDropdown?.classList.add('hidden');
          } else {
            cIsOpen = true;
            customerDropdown?.classList.remove('hidden');
            loadCustomerNotifications();
          }
        });

        customerMarkRead?.addEventListener('click', () => {
          localStorage.setItem(C_LAST_READ, new Date().toISOString());
          if (customerBadge) customerBadge.classList.add('hidden');
          customerList?.querySelectorAll('a').forEach(el => el.classList.remove('bg-green-50/60'));
        });

        document.addEventListener('click', (e) => {
          if (cIsOpen && !customerWrap?.contains(e.target as Node)) {
            cIsOpen = false; customerDropdown?.classList.add('hidden');
          }
        });

        // 初期バッジチェック
        loadCustomerNotifications();
      } catch {}
    })();

    logoutButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        await supabase.auth.signOut();
        setAuthUI(false);
        window.location.href = '/';
      });
    });

    supabase.auth.onAuthStateChange((_event, session) => setAuthUI(!!session));
    </script>
  </body>
</html>
